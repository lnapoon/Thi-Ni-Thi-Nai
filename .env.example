# ==========================================
# Django Application Configuration
# ==========================================
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-random-secret-key-12345
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==========================================
# Database Configuration
# ==========================================
# Leave blank to use local SQLite (default in dev)
# Or provide PostgreSQL URL: postgres://user:password@localhost:5432/dbname
DATABASE_URL=

# ==========================================
# Pluggable Storage Backend Configuration
# ==========================================
# Options: 'local', 'cloudinary', 's3' (covers AWS S3, Cloudflare R2, Backblaze B2)
STORAGE_BACKEND=local

# --- Cloudinary Configuration (when STORAGE_BACKEND=cloudinary) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional single URL format:
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# --- S3 / Cloudflare R2 / Backblaze B2 (when STORAGE_BACKEND=s3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# Custom endpoint for R2 / B2 (e.g., https://<account_id>.r2.cloudflarestorage.com):
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# ==========================================
# Email Configuration (Gmail SMTP)
# ==========================================
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_google_app_password
